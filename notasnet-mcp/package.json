{
  "name": "@trueforge-studio/notasnet-mcp",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Local MCP (Model Context Protocol) server that wraps notasnet-client and exposes the Notasnet school portal API as MCP tools over stdio.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "notasnet-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:mcpb-server": "tsup --config tsup.mcpb.config.ts",
    "mcpb:validate": "mcpb validate mcpb/manifest.json",
    "mcpb:pack": "mcpb pack mcpb dist/notasnet-mcp.mcpb",
    "build:mcpb": "npm run build:mcpb-server && npm run mcpb:validate && npm run mcpb:pack"
  },
  "keywords": [
    "notasnet",
    "syscol",
    "mcp",
    "model-context-protocol"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@trueforge-studio/notasnet-client": "^0.1.0",
    "mammoth": "^1.12.2",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.1"
  },
  "packageManager": "npm@11.3.0"
}
